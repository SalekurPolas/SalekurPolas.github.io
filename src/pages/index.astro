---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 md:py-32 px-6 border-b border-border-dark/30">
    <!-- Grid Overlay Decoration -->
    <div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
    
    <!-- Glowing background lights for depth -->
    <div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-accent-teal/5 rounded-full blur-[100px] pointer-events-none animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[350px] h-[350px] bg-accent-blue/5 rounded-full blur-[100px] pointer-events-none animate-pulse-slow"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Column: Bio & Call to Actions -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent-teal/20 bg-accent-teal/5 text-accent-teal text-xs font-mono tracking-widest uppercase mb-6 animate-fade-in">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-teal animate-ping"></span>
            Available for selective contracts
          </div>
          
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-sans font-extrabold tracking-tight text-gradient mb-4 animate-slide-up">
            Salekur Rahaman
          </h1>
          
          <p class="text-xs sm:text-sm md:text-base lg:text-lg font-mono text-secondary tracking-normal sm:tracking-wide mb-8 animate-slide-up delay-100 whitespace-nowrap">
            Engineer <span class="text-accent-teal">·</span> Product Architect <span class="text-accent-teal">·</span> AI Specialist
          </p>
          
          <p class="text-base sm:text-lg text-secondary max-w-2xl leading-relaxed mb-10 animate-slide-up delay-200">
            I turn complex architectural ideas into scalable software products.
            Specialized in robust backend systems, cross-platform mobile apps,
            AI-powered semantic search integration, and hardware-software IoT solutions.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 animate-slide-up delay-300">
            <a href="/work" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-accent-teal to-accent-blue text-bg-dark font-mono font-bold text-sm tracking-widest text-center hover:opacity-95 transition-opacity shadow-lg shadow-accent-teal/15">
              EXPLORE MY WORK
            </a>
            <a href="https://github.com/SalekurPolas" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-4 rounded-xl border border-border-dark hover:border-secondary text-secondary hover:text-primary font-mono text-sm tracking-widest text-center transition-all bg-bg-card/40">
              GITHUB PROFILE
            </a>
          </div>
        </div>

        <!-- Right Column: Interactive Mock Terminal -->
        <div class="lg:col-span-5 hidden lg:block animate-fade-in delay-200">
          <div class="rounded-xl border border-border-dark/80 bg-bg-card/80 glass shadow-2xl overflow-hidden font-mono text-[11px] text-secondary">
            <!-- Window header -->
            <div class="flex items-center justify-between px-4 py-3 bg-bg-card/90 border-b border-border-dark/60">
              <div class="flex gap-1.5">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
              </div>
              <span class="text-[10px] text-muted">salekur.json</span>
              <div class="w-12"></div>
            </div>
            <!-- Terminal code content -->
            <div class="p-6 space-y-3.5 text-left leading-relaxed">
              <div>
                <span class="text-accent-teal">const</span> <span class="text-primary">developer</span> = <span class="text-accent-blue">&#123;</span>
              </div>
              <div class="pl-4">
                <span class="text-muted">name:</span> <span class="text-accent-teal">"Salekur Rahaman"</span>,
              </div>
              <div class="pl-4">
                <span class="text-muted">location:</span> <span class="text-accent-teal">"Rajshahi, Bangladesh"</span>,
              </div>
              <div class="pl-4">
                <span class="text-muted">stack:</span> <span class="text-accent-blue">[</span>
                <span class="text-accent-teal">"Laravel"</span>, <span class="text-accent-teal">"Flutter"</span>, <span class="text-accent-teal">"Python"</span>, <span class="text-accent-teal">"Qdrant"</span>
                <span class="text-accent-blue">]</span>,
              </div>
              <div class="pl-4">
                <span class="text-muted">capabilities:</span> <span class="text-accent-blue">[</span>
                <div class="pl-4">
                  <span class="text-accent-teal">"Scalable Backends"</span>,
                </div>
                <div class="pl-4">
                  <span class="text-accent-teal">"AI Search Pipelines"</span>,
                </div>
                <div class="pl-4">
                  <span class="text-accent-teal">"Cross-Platform Apps"</span>
                </div>
                <span class="text-accent-blue">]</span>,
              </div>
              <div class="pl-4">
                <span class="text-muted">activeProducts:</span> <span class="text-accent-blue">[</span>
                <span class="text-accent-teal">"Lagbe"</span>, <span class="text-accent-teal">"Tuhur"</span>, <span class="text-accent-teal">"Bachelor"</span>
                <span class="text-accent-blue">]</span>,
              </div>
              <div class="pl-4">
                <span class="text-muted">status:</span> <span class="text-accent-teal">"Shipping Products & Scalable Systems"</span>
              </div>
              <div>
                <span class="text-accent-blue">&#125;;</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Currently Status / Live Focus Radar Section -->
  <section class="border-b border-border-dark/40 py-12 px-6 bg-bg-card/20 relative overflow-hidden">
    <!-- Subtle background accent glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-24 bg-accent-teal/10 blur-3xl pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <!-- Section Header with Live Ping -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">
        <div class="flex items-center gap-3">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-teal opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-teal"></span>
          </span>
          <h2 class="text-xs font-mono tracking-widest text-accent-teal uppercase font-semibold">
            CURRENT FOCUS & ACTIVE PRODUCTS
          </h2>
        </div>
        <span class="font-mono text-[10px] text-muted tracking-wider uppercase">
          LIVE STATUS · 3 PRODUCTS IN ACTIVE DEVELOPMENT
        </span>
      </div>

      <!-- 3-Column Interactive Glass Focus Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        
        <!-- Focus Item 1: Lagbe -->
        <div class="group p-6 rounded-2xl glass-card border border-border-dark/70 bg-bg-card/40 hover:border-accent-teal/50 transition-all duration-300 relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 w-24 h-24 bg-accent-teal/5 rounded-full blur-2xl group-hover:bg-accent-teal/15 transition-all"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[10px] font-mono tracking-wider uppercase bg-accent-teal/10 text-accent-teal border border-accent-teal/20 font-medium">
                MARKETPLACE ECOSYSTEM
              </span>
              <span class="text-[10px] font-mono text-muted group-hover:text-accent-teal transition-colors">
                BUILDING
              </span>
            </div>
            <h3 class="text-base font-sans font-bold text-primary group-hover:text-accent-teal transition-colors mb-2 flex items-center gap-2">
              Lagbe Platform
              <span class="text-xs text-muted font-mono font-normal group-hover:translate-x-0.5 transition-transform">→</span>
            </h3>
            <p class="text-xs text-secondary leading-relaxed">
              Architecting multi-sided booking & dispatch flows, payment escrow cycles, Redis queue workers, and native Flutter apps.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-border-dark/40 flex items-center justify-between text-[11px] font-mono text-muted">
            <span>Laravel · Flutter · Redis</span>
            <a href="/work/lagbe" class="text-accent-teal hover:underline text-[10px] tracking-wider uppercase font-semibold">Case Study ↗</a>
          </div>
        </div>

        <!-- Focus Item 2: Tuhur -->
        <div class="group p-6 rounded-2xl glass-card-blue glass-card border border-border-dark/70 bg-bg-card/40 hover:border-accent-blue/50 transition-all duration-300 relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 w-24 h-24 bg-accent-blue/5 rounded-full blur-2xl group-hover:bg-accent-blue/15 transition-all"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[10px] font-mono tracking-wider uppercase bg-accent-blue/10 text-accent-blue border border-accent-blue/20 font-medium">
                DISCOVERY PLATFORM
              </span>
              <span class="text-[10px] font-mono text-muted group-hover:text-accent-blue transition-colors">
                IN PROGRESS
              </span>
            </div>
            <h3 class="text-base font-sans font-bold text-primary group-hover:text-accent-blue transition-colors mb-2 flex items-center gap-2">
              Tuhur
              <span class="text-xs text-muted font-mono font-normal group-hover:translate-x-0.5 transition-transform">→</span>
            </h3>
            <p class="text-xs text-secondary leading-relaxed">
              Developing localized Flutter & Laravel mobile discovery architecture for spatial mosque mapping, geohashes, and offline prayer schedules.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-border-dark/40 flex items-center justify-between text-[11px] font-mono text-muted">
            <span>Flutter · Dart · Laravel</span>
            <a href="/work/tuhur" class="text-accent-blue hover:underline text-[10px] tracking-wider uppercase font-semibold">Case Study ↗</a>
          </div>
        </div>

        <!-- Focus Item 3: Bachelor -->
        <div class="group p-6 rounded-2xl glass-card border border-border-dark/70 bg-bg-card/40 hover:border-accent-teal/50 transition-all duration-300 relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 w-24 h-24 bg-accent-teal/5 rounded-full blur-2xl group-hover:bg-accent-teal/15 transition-all"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[10px] font-mono tracking-wider uppercase bg-bg-dark/80 text-secondary border border-border-dark/60 font-medium">
                SHARED LIVING APP
              </span>
              <span class="text-[10px] font-mono text-muted group-hover:text-accent-teal transition-colors">
                IN PROGRESS
              </span>
            </div>
            <h3 class="text-base font-sans font-bold text-primary group-hover:text-accent-teal transition-colors mb-2 flex items-center gap-2">
              Bachelor
              <span class="text-xs text-muted font-mono font-normal group-hover:translate-x-0.5 transition-transform">→</span>
            </h3>
            <p class="text-xs text-secondary leading-relaxed">
              Building an Android app simplifying bachelor life with shared meal ledgers, roommate expense splitting, and Google Classroom task sync.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-border-dark/40 flex items-center justify-between text-[11px] font-mono text-muted">
            <span>Android · Java · Firebase</span>
            <a href="/work/bachelor" class="text-accent-teal hover:underline text-[10px] tracking-wider uppercase font-semibold">Case Study ↗</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section class="py-24 px-6 max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-16">
      <div>
        <h2 class="text-xs font-mono tracking-widest text-accent-teal uppercase mb-2">01 / SELECTED PROJECTS</h2>
        <h3 class="text-3xl font-sans font-bold tracking-tight text-primary">Featured Case Studies</h3>
      </div>
      <a href="/work" class="font-mono text-xs text-accent-blue hover:text-accent-teal transition-colors tracking-widest">
        VIEW ALL WORK ({allProjects.length}) ↗
      </a>
    </div>

    <!-- Project List Rows -->
    <div class="divide-y divide-border-dark/40 border-y border-border-dark/40">
      {featuredProjects.map((project, index) => (
        <a href={`/work/${project.id}`} class="group flex flex-col md:flex-row md:items-center justify-between py-6 hover:px-4 transition-all duration-300 rounded-lg hover:bg-bg-card/30">
          <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 flex-grow">
            <!-- Year & Category -->
            <div class="flex md:flex-col gap-2 md:gap-1 text-xs font-mono text-muted w-28 shrink-0">
              <span>{project.data.year}</span>
              <span class="md:hidden text-border-dark">•</span>
              <span class="text-[9px] tracking-widest uppercase text-accent-teal font-semibold">{project.data.category}</span>
            </div>
            
            <!-- Title & Description -->
            <div class="max-w-2xl">
              <h4 class="text-lg font-sans font-bold text-primary group-hover:text-accent-teal transition-colors flex items-center gap-2">
                {project.data.title}
                <span class="text-xs font-mono font-normal text-secondary uppercase tracking-wider">({project.data.shortTitle})</span>
              </h4>
              <p class="text-sm text-secondary leading-relaxed mt-1">
                {project.data.description}
              </p>
            </div>
          </div>

          <!-- Technologies & Action -->
          <div class="flex items-center gap-6 mt-4 md:mt-0 justify-between md:justify-end shrink-0">
            <div class="flex flex-wrap gap-2">
              {project.data.technologies.slice(0, 3).map(tech => (
                <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-bg-card/80 border border-border-dark/60 text-secondary font-medium">
                  {tech}
                </span>
              ))}
              {project.data.technologies.length > 3 && (
                <span class="text-[11px] font-mono px-2 py-1 rounded-md bg-bg-card/40 border border-border-dark/40 text-muted">
                  +{project.data.technologies.length - 3}
                </span>
              )}
            </div>
            <span class="text-accent-blue group-hover:text-accent-teal group-hover:translate-x-1 transition-all text-sm hidden md:inline">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Engineering Philosophy (How I Build) -->
  <section class="py-24 px-6 border-y border-border-dark/30 bg-bg-card/20">
    <div class="max-w-4xl mx-auto text-center md:text-left">
      <h2 class="text-xs font-mono tracking-widest text-accent-teal uppercase mb-6">02 / PHILOSOPHY</h2>
      <h3 class="text-3xl md:text-5xl font-serif italic text-primary mb-8 leading-tight">
        "I don't want to only write code. I want to build things that matter."
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 text-left font-mono">
        <div class="border-l border-border-dark pl-4">
          <h4 class="text-sm text-accent-teal font-bold mb-2 uppercase">1. Systems-First</h4>
          <p class="text-xs text-secondary leading-relaxed">
            I map complex relations, database flows, caches, and queues before laying down code. A smooth system prevents developer overhead.
          </p>
        </div>
        <div class="border-l border-border-dark pl-4">
          <h4 class="text-sm text-accent-teal font-bold mb-2 uppercase">2. Pragmatic AI</h4>
          <p class="text-xs text-secondary leading-relaxed">
            I build practical AI features—like semantic vector searches, OpenCV edge triggers—that solve real user interaction problems.
          </p>
        </div>
        <div class="border-l border-border-dark pl-4">
          <h4 class="text-sm text-accent-teal font-bold mb-2 uppercase">3. Clean Packaging</h4>
          <p class="text-xs text-secondary leading-relaxed">
            I focus heavily on packaging reuse, zero dependencies when writing tools (like V-Signature), and highly readable codebases.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Engineering Stack Section -->
  <section class="py-24 px-6 max-w-6xl mx-auto">
    <div class="text-center md:text-left mb-16">
      <h2 class="text-xs font-mono tracking-widest text-accent-teal uppercase mb-2">03 / TECHNICAL CAPABILITIES</h2>
      <h3 class="text-3xl font-sans font-bold tracking-tight text-primary">Core Engineering Stack</h3>
    </div>

    <!-- Skills Category list -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 font-mono text-xs">
      
      <!-- Backend System Card -->
      <div class="p-6 rounded-xl border border-border-dark/60 bg-bg-card/30">
        <div class="w-8 h-8 rounded-lg bg-accent-teal/10 text-accent-teal flex items-center justify-center font-bold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h4 class="text-sm text-primary font-bold mb-4 uppercase">Backend Systems</h4>
        <ul class="space-y-2 text-secondary">
          <li>Laravel · PHP</li>
          <li>MySQL (Relational SQL)</li>
          <li>Redis (Cache & Queues)</li>
          <li>REST & GraphQL APIs</li>
          <li>WebSockets Communication</li>
          <li>Database Architecture</li>
        </ul>
      </div>

      <!-- Frontends Card -->
      <div class="p-6 rounded-xl border border-border-dark/60 bg-bg-card/30">
        <div class="w-8 h-8 rounded-lg bg-accent-blue/10 text-accent-blue flex items-center justify-center font-bold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h4 class="text-sm text-primary font-bold mb-4 uppercase">Interactive UI</h4>
        <ul class="space-y-2 text-secondary">
          <li>Vue.js (Framework)</li>
          <li>Livewire · Alpine.js</li>
          <li>Tailwind CSS (v3 / v4)</li>
          <li>TypeScript / Vanilla JS</li>
          <li>HTML5 Canvas drawing</li>
          <li>Responsive Styling</li>
        </ul>
      </div>

      <!-- Mobile & Hardware Card -->
      <div class="p-6 rounded-xl border border-border-dark/60 bg-bg-card/30">
        <div class="w-8 h-8 rounded-lg bg-accent-teal/10 text-accent-teal flex items-center justify-center font-bold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <h4 class="text-sm text-primary font-bold mb-4 uppercase">Mobile & IoT</h4>
        <ul class="space-y-2 text-secondary">
          <li>Flutter · Dart</li>
          <li>Native Mobile UI</li>
          <li>Raspberry Pi Projects</li>
          <li>MQTT Local Networks</li>
          <li>Arduino & ESP8266</li>
          <li>Hardware Sensors</li>
        </ul>
      </div>

      <!-- AI & Vector Card -->
      <div class="p-6 rounded-xl border border-border-dark/60 bg-bg-card/30">
        <div class="w-8 h-8 rounded-lg bg-accent-blue/10 text-accent-blue flex items-center justify-center font-bold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        </div>
        <h4 class="text-sm text-primary font-bold mb-4 uppercase">AI & Vector Search</h4>
        <ul class="space-y-2 text-secondary">
          <li>Python (Data/FastAPI)</li>
          <li>Qdrant Vector Database</li>
          <li>Text Vector Embeddings</li>
          <li>OpenAI / Claude APIs</li>
          <li>OpenCV Image Pipelines</li>
          <li>Semantic Math models</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Final Call to Action -->
  <section class="relative py-24 px-6 border-t border-border-dark/30 overflow-hidden">
    <div class="absolute inset-0 bg-bg-card/10 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h3 class="text-xs font-mono tracking-widest text-accent-teal uppercase mb-4">04 / COLLABORATION</h3>
      <h4 class="text-3xl md:text-5xl font-sans font-bold tracking-tight text-primary mb-6">
        Let's build together.
      </h4>
      <p class="text-base text-secondary max-w-lg mx-auto leading-relaxed mb-10">
        Whether you need a scalable marketplace system, custom mobile integrations, or AI-powered semantic matching, I can help architect and build it.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 font-mono text-sm tracking-wider">
        <a href="/contact" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-primary text-bg-dark font-bold hover:bg-secondary transition-colors">
          GET IN TOUCH
        </a>
        <a href="mailto:salekur@lagbe.dev" class="w-full sm:w-auto px-8 py-4 rounded-xl border border-border-dark hover:border-muted text-secondary hover:text-primary transition-all">
          salekur@lagbe.dev
        </a>
      </div>
    </div>
  </section>
</Layout>
