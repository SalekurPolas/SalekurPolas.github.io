---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="The Lab | Salekur Rahaman"
  description="Explore the personal open-source libraries, IoT scripts, and technology experiments built by Salekur Rahaman."
>
  <section class="py-20 px-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="border-b border-border-dark/30 pb-12 mb-12">
      <h1 class="text-xs font-mono tracking-widest text-accent-teal uppercase mb-3">EXPERIMENTAL LAB</h1>
      <h2 class="text-3xl sm:text-5xl font-sans font-bold tracking-tight text-gradient mb-4">
        Open Source & Experiments
      </h2>
      <p class="text-secondary max-w-xl leading-relaxed text-sm sm:text-base">
        A directory of packages, open-source contributions, IoT configurations, and technical sandbox files.
      </p>
    </div>

    <!-- Lab Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Experiment 1: V-Signature -->
      <div class="p-6 rounded-2xl glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-accent-teal/10 text-accent-teal border border-accent-teal/20">
              NPM PACKAGE
            </span>
            <span class="font-mono text-[10px] text-muted">2023</span>
          </div>
          <h3 class="text-lg font-sans font-bold text-primary mb-2">v-signature</h3>
          <p class="text-xs text-secondary leading-relaxed mb-6">
            A zero-dependency vanilla JavaScript library to capture, scale, and export smooth signatures on HTML5 Canvas. Supports pressure-sensitive touch coordinates.
          </p>
        </div>
        <div class="flex items-center gap-4 pt-4 border-t border-border-dark/30 font-mono text-[10px] tracking-wider">
          <a href="https://github.com/SalekurPolas/v-signature" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:text-accent-teal transition-colors">
            GITHUB ↗
          </a>
          <a href="/work/v-signature" class="text-secondary hover:text-accent-teal transition-colors">
            CASE STUDY →
          </a>
        </div>
      </div>

      <!-- Experiment 2: MagicMirror Module MMM-Pinfo -->
      <div class="p-6 rounded-2xl glass-card-blue glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-accent-blue/10 text-accent-blue border border-accent-blue/20">
              MAGICMIRROR² MODULE
            </span>
            <span class="font-mono text-[10px] text-muted">2023</span>
          </div>
          <h3 class="text-lg font-sans font-bold text-primary mb-2">MMM-Pinfo</h3>
          <p class="text-xs text-secondary leading-relaxed mb-6">
            An informational dashboard widget extension built for the MagicMirror² framework. Handles dynamic API parsing and displays scheduled system telemetry alerts on a smart mirror display.
          </p>
        </div>
        <div class="flex items-center gap-4 pt-4 border-t border-border-dark/30 font-mono text-[10px] tracking-wider">
          <a href="https://github.com/SalekurPolas" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:text-accent-teal transition-colors">
            GITHUB ↗
          </a>
        </div>
      </div>

      <!-- Experiment 3: OpenCV Face Recognition Service -->
      <div class="p-6 rounded-2xl glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-bg-dark/80 border border-border-dark/50 text-secondary">
              PYTHON SANDBOX
            </span>
            <span class="font-mono text-[10px] text-muted">2023</span>
          </div>
          <h3 class="text-lg font-sans font-bold text-primary mb-2">rpi-vision-mqtt</h3>
          <p class="text-xs text-secondary leading-relaxed mb-6">
            A lightweight OpenCV pipeline designed to perform facial detection on Raspberry Pi hardware, translating camera triggers to instant local MQTT messaging alerts for frontend updates.
          </p>
        </div>
        <div class="flex items-center gap-4 pt-4 border-t border-border-dark/30 font-mono text-[10px] tracking-wider">
          <span class="text-muted uppercase">Hardware Prototype</span>
        </div>
      </div>

      <!-- Experiment 4: Semantic Search Pipeline -->
      <div class="p-6 rounded-2xl glass-card-blue glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-bg-dark/80 border border-border-dark/50 text-secondary">
              DOCKER STACK
            </span>
            <span class="font-mono text-[10px] text-muted">2024</span>
          </div>
          <h3 class="text-lg font-sans font-bold text-primary mb-2">qdrant-laravel-bridge</h3>
          <p class="text-xs text-secondary leading-relaxed mb-6">
            A quick-setup Docker Compose blueprint containing a Laravel backend sync service, Redis job manager, and a Qdrant cluster to integrate vector databases in legacy systems.
          </p>
        </div>
        <div class="flex items-center gap-4 pt-4 border-t border-border-dark/30 font-mono text-[10px] tracking-wider">
          <span class="text-muted uppercase">Docker Sandbox</span>
        </div>
      </div>

      <!-- Experiment 5: Custom SMS Gateway Observer -->
      <div class="p-6 rounded-2xl glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-accent-blue/10 text-accent-blue border border-accent-blue/20">
              LARAVEL PACKAGE
            </span>
            <span class="font-mono text-[10px] text-muted">2022</span>
          </div>
          <h3 class="text-lg font-sans font-bold text-primary mb-2">laravel-sms-notifier</h3>
          <p class="text-xs text-secondary leading-relaxed mb-6">
            A modular notification channel package enabling automatic failover and routing across multiple South-Asian SMS gateways, featuring custom metrics logging.
          </p>
        </div>
        <div class="flex items-center gap-4 pt-4 border-t border-border-dark/30 font-mono text-[10px] tracking-wider">
          <a href="https://github.com/SalekurPolas" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:text-accent-teal transition-colors">
            GITHUB ↗
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
