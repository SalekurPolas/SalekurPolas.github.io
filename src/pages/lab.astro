---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="The Lab | Salekur Rahaman"
  description="Explore open-source libraries, packages, and technical modules built by Salekur Rahaman."
>
  <section class="py-20 px-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="border-b border-border-dark/30 pb-12 mb-12">
      <h1 class="text-xs font-mono tracking-widest text-accent-teal uppercase mb-3">EXPERIMENTAL LAB</h1>
      <h2 class="text-3xl sm:text-5xl font-sans font-bold tracking-tight text-gradient mb-4">
        Open Source & Packages
      </h2>
      <p class="text-secondary max-w-xl leading-relaxed text-sm sm:text-base">
        A curated collection of open-source libraries, developer tools, and modular extensions created and maintained by Salekur.
      </p>
    </div>

    <!-- Lab Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Package 1: V-Signature -->
      <div class="p-8 rounded-2xl glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-accent-teal/10 text-accent-teal border border-accent-teal/20">
              NPM PACKAGE
            </span>
            <span class="font-mono text-[10px] text-muted">2023</span>
          </div>
          <h3 class="text-2xl font-sans font-bold text-primary mb-3">v-signature</h3>
          <p class="text-sm text-secondary leading-relaxed mb-6">
            A zero-dependency vanilla JavaScript library to capture, scale, and export smooth signatures on HTML5 Canvas. Features Retina/DPR scaling and quadratic Bézier curve vector smoothing for natural strokes.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-5 pt-6 border-t border-border-dark/30 font-mono text-xs tracking-wider">
          <a href="https://github.com/SalekurPolas/v-signature" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:text-accent-teal transition-colors">
            GITHUB ↗
          </a>
          <a href="https://salekurpolas.github.io/v-signature" target="_blank" rel="noopener noreferrer" class="text-accent-teal hover:underline transition-colors">
            LIVE DEMO ↗
          </a>
          <a href="/work/v-signature" class="text-secondary hover:text-primary transition-colors ml-auto">
            CASE STUDY →
          </a>
        </div>
      </div>

      <!-- Package 2: MagicMirror Module MMM-Pinfo -->
      <div class="p-8 rounded-2xl glass-card-blue glass-card flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-6">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-mono tracking-wider uppercase bg-accent-blue/10 text-accent-blue border border-accent-blue/20">
              MAGICMIRROR² MODULE
            </span>
            <span class="font-mono text-[10px] text-muted">2023</span>
          </div>
          <h3 class="text-2xl font-sans font-bold text-primary mb-3">MMM-Pinfo</h3>
          <p class="text-sm text-secondary leading-relaxed mb-6">
            A real-time hardware telemetry and diagnostic extension for the MagicMirror² platform. Streams CPU temperature, RAM usage, storage metrics, network IP details, and broadcasts configurable threshold alerts.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-5 pt-6 border-t border-border-dark/30 font-mono text-xs tracking-wider">
          <a href="https://github.com/SalekurPolas/MMM-Pinfo" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:text-accent-teal transition-colors">
            GITHUB ↗
          </a>
          <a href="/work/mmm-pinfo" class="text-secondary hover:text-primary transition-colors ml-auto">
            CASE STUDY →
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
